# scottames/ghostty COPR. ghostty is not packaged in Fedora itself (nothing in
# F43 through rawhide), and this is the COPR the Ghostty docs point to. Verbatim output
# of `dnf copr enable scottames/ghostty` plus includepkgs: this COPR also builds
# gtk4-layer-shell and zig, which exist in Fedora proper and must not be shadowed
# by it. image/packages.sh copies it in ahead of the dnf install (the overlays
# arrive after that step).
[copr:copr.fedorainfracloud.org:scottames:ghostty]
name=Copr repo for ghostty owned by scottames
baseurl=https://download.copr.fedorainfracloud.org/results/scottames/ghostty/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/scottames/ghostty/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
includepkgs=ghostty
