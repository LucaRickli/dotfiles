# ghcr.io/lucarickli/devcontainer: Go, Deno and Rust with their tooling, for
# VS Code Dev Containers and for `toolbox create --image`. x86_64 only.
#
# Works without internet once the image is local: the language servers and
# linters are in the image, and so are the VS Code extensions for them.
# (The VS Code Server itself comes from the client; see the README.)
#
# Toolchain downloads are checked against the checksum their upstream
# publishes (the VS Code Server against its update API's hash), so a version
# bump (Renovate, the `# renovate:` comments) needs no hand-edited hash. The
# marketplace publishes none for .vsix files: those are pinned by version and
# fetched over HTTPS only.

# --- VS Code extensions, installed with a throwaway VS Code Server ------------
# Only the resulting extensions directory is copied into the image. It does not
# depend on the server version: any client VS Code that satisfies the
# extensions' `engines` uses them. Pin STABLE versions: the marketplace lists
# pre-releases as the newest (golang.go, rust-analyzer), and a baked-in
# extension never updates itself.
FROM registry.fedoraproject.org/fedora-toolbox:44 AS vscode-extensions
# renovate: datasource=github-releases depName=microsoft/vscode
ARG VSCODE_VERSION=1.139.1
# The GitHub releases track the marketplace versions; vscode-go's odd-minor
# pre-releases are marked as such there, so Renovate skips them.
# renovate: datasource=github-releases depName=golang/vscode-go extractVersion=^v(?<version>.+)$
ARG GO_EXT_VERSION=0.56.1
# renovate: datasource=github-releases depName=denoland/vscode_deno
ARG DENO_EXT_VERSION=3.53.1
# Not tracked by Renovate, bump by hand: rust-analyzer's GitHub releases are
# dated (2026-09-21), the marketplace version (0.3.NNNN stable, 0.4.NNNN
# pre-release) appears in no feed Renovate can read.
ARG RUST_ANALYZER_EXT_VERSION=0.3.3057
ARG DEV_HOME=/var/home/dev
RUN set -eux; dnf -y install jq; cd /tmp; \
    info=$(curl -fsSL "https://update.code.visualstudio.com/api/versions/${VSCODE_VERSION}/server-linux-x64/stable"); \
    commit=$(echo "$info" | jq -r .version); \
    sha=$(echo "$info" | jq -r .sha256hash); \
    curl -fsSLo server.tgz "https://update.code.visualstudio.com/commit:${commit}/server-linux-x64/stable"; \
    echo "${sha}  server.tgz" | sha256sum -c -; \
    mkdir server; tar -xzf server.tgz --strip-components=1 -C server; \
    gallery=https://marketplace.visualstudio.com/_apis/public/gallery/publishers; \
    curl -fsSL --compressed -o go.vsix "${gallery}/golang/vsextensions/go/${GO_EXT_VERSION}/vspackage"; \
    curl -fsSL --compressed -o deno.vsix "${gallery}/denoland/vsextensions/vscode-deno/${DENO_EXT_VERSION}/vspackage"; \
    curl -fsSL --compressed -o ra.vsix "${gallery}/rust-lang/vsextensions/rust-analyzer/${RUST_ANALYZER_EXT_VERSION}/vspackage?targetPlatform=linux-x64"; \
    HOME=/tmp/home ./server/bin/code-server --accept-server-license-terms \
        --extensions-dir "${DEV_HOME}/.vscode-server/extensions" \
        --install-extension /tmp/go.vsix \
        --install-extension /tmp/deno.vsix \
        --install-extension /tmp/ra.vsix; \
    for id in golang.go denoland.vscode-deno rust-lang.rust-analyzer; do \
        ls -d "${DEV_HOME}/.vscode-server/extensions/${id}-"*; \
    done

FROM registry.fedoraproject.org/fedora-toolbox:44

# renovate: datasource=golang-version depName=golang
ARG GO_VERSION=1.27.1
# renovate: datasource=go depName=golang.org/x/tools/gopls
ARG GOPLS_VERSION=v0.23.0
# renovate: datasource=go depName=github.com/go-delve/delve
ARG DLV_VERSION=v1.27.2
# renovate: datasource=github-releases depName=dominikh/go-tools
ARG STATICCHECK_VERSION=2026.2.1
# renovate: datasource=go depName=mvdan.cc/gofumpt
ARG GOFUMPT_VERSION=v0.12.0
# renovate: datasource=github-releases depName=golangci/golangci-lint extractVersion=^v(?<version>.+)$
ARG GOLANGCI_LINT_VERSION=2.14.0
# renovate: datasource=github-releases depName=denoland/deno extractVersion=^v(?<version>.+)$
ARG DENO_VERSION=2.9.7
# renovate: datasource=github-tags depName=rust-lang/rustup
ARG RUSTUP_VERSION=1.29.1
# renovate: datasource=github-releases depName=rust-lang/rust
ARG RUST_VERSION=1.98.1
# Fixed, not tunable: the COPY and the label below use them literally.
ARG DEV_USER=dev
ARG DEV_UID=59999

# C toolchain (the linker for rustc, and cgo), openssl headers for
# openssl-sys, and CLI tools.
RUN dnf -y --setopt=install_weak_deps=False install \
        gcc gcc-c++ make pkgconf-pkg-config openssl-devel \
        jq ripgrep fd-find gh git-lfs ShellCheck strace \
    && dnf clean all && rm -rf /var/cache/dnf /var/cache/libdnf5

ENV LANG=C.UTF-8 \
    PATH=/usr/local/go/bin:/usr/local/cargo/bin:/usr/local/bin:/usr/bin \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    DENO_NO_UPDATE_CHECK=1

# Go from upstream rather than Fedora's golang, which lags a release and
# defaults to GOTOOLCHAIN=local. Tools built with `go install` are checked
# against sum.golang.org; golangci-lint wants its release binary.
RUN set -eux; cd /tmp; \
    curl -fsSLo go.tgz "https://dl.google.com/go/go${GO_VERSION}.linux-amd64.tar.gz"; \
    echo "$(curl -fsSL "https://dl.google.com/go/go${GO_VERSION}.linux-amd64.tar.gz.sha256")  go.tgz" | sha256sum -c -; \
    tar -C /usr/local -xzf go.tgz; rm go.tgz; \
    export GOPATH=/tmp/gopath GOCACHE=/tmp/gocache GOBIN=/usr/local/bin GOTOOLCHAIN=local; \
    go install "golang.org/x/tools/gopls@${GOPLS_VERSION}"; \
    go install "github.com/go-delve/delve/cmd/dlv@${DLV_VERSION}"; \
    go install "honnef.co/go/tools/cmd/staticcheck@${STATICCHECK_VERSION}"; \
    go install "mvdan.cc/gofumpt@${GOFUMPT_VERSION}"; \
    rm -rf /tmp/gopath /tmp/gocache; \
    gl="golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64.tar.gz"; \
    base="https://github.com/golangci/golangci-lint/releases/download/v${GOLANGCI_LINT_VERSION}"; \
    curl -fsSLO "${base}/${gl}"; \
    curl -fsSL "${base}/golangci-lint-${GOLANGCI_LINT_VERSION}-checksums.txt" | grep " ${gl}\$" | sha256sum -c -; \
    tar -xzf "$gl" --strip-components=1 -C /usr/local/bin "${gl%.tar.gz}/golangci-lint"; \
    rm "$gl"

# Deno (not packaged in Fedora). The VS Code extension finds it on PATH.
RUN set -eux; cd /tmp; \
    zip=deno-x86_64-unknown-linux-gnu.zip; \
    base="https://github.com/denoland/deno/releases/download/v${DENO_VERSION}"; \
    curl -fsSLO "${base}/${zip}"; \
    curl -fsSL "${base}/${zip}.sha256sum" | sha256sum -c -; \
    unzip -q "$zip" -d /usr/local/bin; rm "$zip"; chmod 0755 /usr/local/bin/deno

# Rust through rustup, system-wide like the official rust image, so
# rust-toolchain.toml files and `rustup target add` work. World-writable
# because whoever runs the container (a remapped dev user, or the toolbox
# user) owns neither directory.
RUN set -eux; cd /tmp; \
    base="https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu"; \
    curl -fsSLO "${base}/rustup-init"; \
    echo "$(curl -fsSL "${base}/rustup-init.sha256" | cut -d' ' -f1)  rustup-init" | sha256sum -c -; \
    chmod +x rustup-init; \
    ./rustup-init -y --no-modify-path --profile minimal --default-toolchain "${RUST_VERSION}" \
        --component clippy,rustfmt,rust-src,rust-analyzer; \
    rm rustup-init; \
    chmod -R a+w "${RUSTUP_HOME}" "${CARGO_HOME}"

# Per-user bin dirs of `go install` and `deno install -g`, for login shells
# (Dev Containers probes the environment through one).
RUN printf '%s\n' \
    'for d in "$HOME/go/bin" "$HOME/.deno/bin"; do' \
    '    case ":$PATH:" in *":$d:"*) ;; *) PATH="$PATH:$d" ;; esac' \
    'done' \
    'export PATH' > /etc/profile.d/devcontainer-path.sh

# The Dev Containers user. updateRemoteUserUID rewrites its UID to the host
# user's when a dev container is created (with podman the CLI also adds
# --userns=keep-id), so workspace files stay yours. Two constraints come from
# toolbox, which creates its own user from the host at runtime:
# - the home is not under /home: on hosts where /home is a symlink (bootc,
#   ostree) toolbox replaces /home and fails if it is not empty;
# - the UID is not 1000: toolbox runs `useradd --uid <host uid>` without -o.
RUN set -eux; \
    mkdir -p /var/home; \
    groupadd --gid "${DEV_UID}" "${DEV_USER}"; \
    useradd --uid "${DEV_UID}" --gid "${DEV_UID}" --groups wheel \
        --home-dir "/var/home/${DEV_USER}" --create-home --shell /bin/bash "${DEV_USER}"; \
    echo "${DEV_USER} ALL=(ALL) NOPASSWD: ALL" > "/etc/sudoers.d/${DEV_USER}"; \
    chmod 0440 "/etc/sudoers.d/${DEV_USER}"

COPY --from=vscode-extensions --chown=59999:59999 \
    /var/home/dev/.vscode-server /var/home/dev/.vscode-server

# No USER and no ENTRYPOINT: toolbox forces --user root:root and passes its
# init command as CMD.
#
# devcontainer.metadata makes `"image": "ghcr.io/lucarickli/devcontainer"`
# enough in a project's devcontainer.json. The extensions listed are already
# installed, so offline they are a no-op. checkForUpdates=local keeps the Go
# extension from asking the module proxy about tool versions.
# The org.opencontainers labels replace the ones inherited from fedora-toolbox
# (a derived image cannot unset a label, only override it).
# com.github.containers.toolbox=true is inherited and must stay.
LABEL org.opencontainers.image.title="devcontainer" \
      org.opencontainers.image.description="Go, Deno and Rust dev container (VS Code Dev Containers, toolbox)" \
      org.opencontainers.image.source="https://github.com/lucarickli/dotfiles" \
      org.opencontainers.image.url="https://github.com/lucarickli/dotfiles" \
      org.opencontainers.image.vendor="" \
      org.opencontainers.image.version="" \
      org.opencontainers.image.licenses="" \
      devcontainer.metadata='[{"remoteUser":"dev","customizations":{"vscode":{"extensions":["golang.go","denoland.vscode-deno","rust-lang.rust-analyzer"],"settings":{"go.toolsManagement.checkForUpdates":"local","go.toolsManagement.autoUpdate":false,"go.survey.prompt":false,"files.watcherExclude":{"**/target/**":true}}}}}]'
