#!/bin/sh
# Runs on every machine, at install and on each update, after flatpak
# downloaded the extra-data build.sh declares and checked its sha256:
# code.deb from Microsoft, claude.zst from Anthropic. The sandbox has the
# runtime (the Sdk: ar, tar, xz, zstd) and /app/extra, its cwd, as the only
# writable place.
set -e
ar x code.deb data.tar.xz
tar -xJf data.tar.xz ./usr/share/code
mv usr/share/code vscode
rm -r code.deb data.tar.xz usr

# The icon comes from the .deb as well, so the published image holds nothing
# of Microsoft's. flatpak exports export/ as if it had been built in.
install -Dm644 vscode/resources/app/resources/linux/code.png \
    export/share/icons/hicolor/512x512/apps/io.github.lucarickli.Code.png

# Claude Code, run by /app/bin/claude. flatpak writes extra-data 0644.
zstd -dq --rm claude.zst
chmod 0755 claude
