{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "GitHub releases with duplicated version (no v-prefix) in asset name",
      "fileMatch": ["\\.ya?ml(\\.j2)?$"],
      "matchStrings": [
        "https:\\/\\/github.com\\/(?<depName>[^\\/]+\\/[^\\/]+)\\/releases\\/download\\/v?(?<currentValue>[^\\/]+)\\/(?<assetName>[^_]+)_(?<currentValue2>[0-9]+\\.[0-9]+\\.[0-9]+)_(?<suffix>[^\\s\"']+)"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "https://github.com/{{{depName}}}/releases/download/v{{{newValue}}}/{{{assetName}}}_{{{newValue}}}_{{{suffix}}}"
    },
    {
      "customType": "regex",
      "description": "GitHub releases with duplicated version (with v-prefix) in asset name",
      "fileMatch": ["\\.ya?ml(\\.j2)?$"],
      "matchStrings": [
        "https:\\/\\/github.com\\/(?<depName>[^\\/]+\\/[^\\/]+)\\/releases\\/download\\/v?(?<currentValue>[^\\/]+)\\/(?<assetName>[^_]+)_v(?<currentValue2>[0-9]+\\.[0-9]+\\.[0-9]+)_(?<suffix>[^\\s\"']+)"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "https://github.com/{{{depName}}}/releases/download/v{{{newValue}}}/{{{assetName}}}_v{{{newValue}}}_{{{suffix}}}"
    },
    {
      "customType": "regex",
      "description": "Normal GitHub release assets (no version inside asset name)",
      "fileMatch": ["\\.ya?ml(\\.j2)?$"],
      "matchStrings": [
        "https:\\/\\/github.com\\/(?<depName>\\S+?\\/\\S+?)\\/releases\\/download\\/(?<currentValue>(v|\\d)\\S+?)\\/[^\\s\"'\\/_]+(-[^\\s\"'\\/]*)?",
        "https:\\/\\/github.com\\/(?<depName>\\S+?\\/\\S+?)\\/releases\\/download\\/(?<currentValue>(v|\\d)\\S+?)\\/[^\\s\"'\\/_]+_[a-uw-zA-UW-Z][^\\s\"'\\/]*"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
