{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": "GitHub releases",
      "fileMatch": ["packages/binary\\.yaml"],
      "matchStrings": [
        // https://github.com/<owner>/<repo>/releases/download/<version>/<asset>
        "https:\\/\\/github.com\\/(?<depName>\\S+?\\/\\S+?)\\/releases\\/download\\/(?<currentValue>(v|\\d)\\S+?)\\/\\S+"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^(?<version>.*)${{/if}}"
    },
    {
      "customType": "regex",
      "description": "Helm CDN",
      "fileMatch": ["packages/binary\\.yaml"],
      "matchStrings": [
        // https://get.helm.sh/helm-v<version>-linux-amd64.tar.gz
        "https:\\/\\/get\\.helm\\.sh\\/helm-v(?<currentValue>[^-]+)-linux-amd64\\.tar\\.gz"
      ],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "https://get.helm.sh/helm-v{{{newValue}}}-linux-amd64.tar.gz"
    },
    {
      "customType": "regex",
      "description": "kubectl CDN",
      "fileMatch": ["packages/binary\\.yaml"],
      "matchStrings": [
        // https://dl.k8s.io/release/v<version>/bin/linux/amd64/kubectl
        "https:\\/\\/dl\\.k8s\\.io\\/release\\/v(?<currentValue>[^\\/]+)\\/bin\\/linux\\/amd64\\/kubectl"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "https://dl.k8s.io/release/v{{{newValue}}}/bin/linux/amd64/kubectl"
    }
  ]
}
