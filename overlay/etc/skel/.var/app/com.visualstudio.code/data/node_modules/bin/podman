#!/bin/sh
# `podman` inside the VS Code Flatpak, for Dev Containers: runs the host's
# podman through host-spawn, which ships with the Flatpak. VS Code's launcher
# puts this directory on PATH; the Flatpak override in
# /usr/lib/tmpfiles.d/fedora-bootc-flatpak.conf shares /tmp with the host.
exec /app/bin/host-spawn podman "$@"
