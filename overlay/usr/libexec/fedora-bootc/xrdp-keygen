#!/usr/bin/bash
#
# This machine's XRDP keys in /etc/xrdp: the TLS key pair (key.pem, cert.pem)
# and the RSA key of RDP's own security layer (rsakeys.ini). Run by
# xrdp-keygen.service before every start of xrdp; does nothing when the keys
# are in place.
#
# The xrdp package creates them in its %posttrans, which on an image-based
# system runs inside the image build, so they would be the same on every
# machine and published with the image. packages.sh deletes them from the image
# and this creates them per machine, with the package's own commands.
#
# A certificate whose subject is exactly CN=XRDP comes from that scriptlet (it
# is what /etc/xrdp/openssl.conf says), so on this image it was made in an
# image build: it is replaced, together with the rsakeys.ini made alongside it.
# The certificate made here carries O=fedora-bootc as well, so its subject can
# never be mistaken for that one. A certificate you put in place yourself is
# left alone, unless you made it from openssl.conf unchanged (CN=XRDP).
set -euo pipefail
cd /etc/xrdp

tls=false rsa=false
if [ ! -s key.pem ] || [ ! -s cert.pem ]; then
    tls=true
elif ! subject=$(openssl x509 -noout -subject -nameopt RFC2253 -in cert.pem 2>/dev/null); then
    tls=true
elif [ "$subject" = "subject=CN=XRDP" ]; then
    tls=true rsa=true
fi
[ -s rsakeys.ini ] || rsa=true

# Written under temporary names and moved into place, the certificate last:
# an interrupted run leaves either nothing new or a certificate that still
# says CN=XRDP, and the next start of xrdp finishes the job.
rm -f rsakeys.ini.new key.pem.new cert.pem.new
if $rsa; then
    (umask 0137; /usr/bin/xrdp-keygen xrdp rsakeys.ini.new >/dev/null)
    chgrp xrdp rsakeys.ini.new
    chmod 0640 rsakeys.ini.new
    mv -f rsakeys.ini.new rsakeys.ini
    echo "generated /etc/xrdp/rsakeys.ini"
fi
if $tls; then
    # Named after the machine; only the characters a hostname may have, since
    # openssl parses the subject (a raw sethostname can set anything).
    host=$(uname -n | tr -cd 'A-Za-z0-9.-')
    # openssl's chatter is only worth showing when it fails.
    if ! out=$(umask 0337
               openssl req -x509 -newkey rsa:2048 -nodes -days 3652 \
                   -config openssl.conf -subj "/O=fedora-bootc/CN=${host:-localhost}" \
                   -keyout key.pem.new -out cert.pem.new 2>&1); then
        printf '%s\n' "$out" >&2
        exit 1
    fi
    chgrp xrdp key.pem.new cert.pem.new
    chmod 0640 key.pem.new cert.pem.new
    mv -f key.pem.new key.pem
    mv -f cert.pem.new cert.pem
    # What an RDP client shows when it asks to trust this machine (Windows
    # shows the SHA-1 one).
    echo "generated /etc/xrdp/cert.pem, $(openssl x509 -noout -fingerprint -sha256 -in cert.pem)"
    echo "generated /etc/xrdp/cert.pem, $(openssl x509 -noout -fingerprint -sha1 -in cert.pem)"
fi
