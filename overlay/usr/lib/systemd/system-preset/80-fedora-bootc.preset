# Services enabled by this image. build_files/finalize.sh reads this file and
# applies it, so add a unit here rather than calling systemctl there.
#
# tailscale is installed but deliberately NOT enabled (no vendor preset
# enables it either): not every machine should join the tailnet. Per machine:
#   sudo systemctl enable --now tailscaled && sudo tailscale up
#
# Nothing here installs software over the network at first boot, so a machine
# with no network ends up identical to the rest. Flatpaks are installed per
# machine (packages/flatpaks.txt).
#
# greetd (noctalia-greeter) is the display manager. Its unit carries
# Alias=display-manager.service, and nothing else in the image claims it.
enable greetd.service
# Docker: socket-activated, idle until the first `docker` command.
enable docker.socket
# Remote desktop on 3389. xrdp is the RDP front end, xrdp-sesman authenticates
# and starts the session (overlay/etc/xrdp/startwm.sh).
enable xrdp.service
enable xrdp-sesman.service
# Bans repeated login failures on sshd and xrdp (overlay/etc/fail2ban/).
enable fail2ban.service
# systemd-boot's menu stays hidden unless a key is held at power-on
# (overlay/usr/lib/systemd/system/hide-boot-menu.service).
enable hide-boot-menu.service
# Cockpit is opt-in per machine: sudo systemctl enable --now cockpit.socket
disable cockpit.socket
